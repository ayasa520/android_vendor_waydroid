diff --git a/network/netmgr/commander.cpp b/network/netmgr/commander.cpp
new file mode 100644
index 00000000..e7775d2d
--- /dev/null
+++ b/network/netmgr/commander.cpp
@@ -0,0 +1,161 @@
+/*
