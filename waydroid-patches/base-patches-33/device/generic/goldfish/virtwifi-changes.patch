+    OnAckCallback mOnAckCallback;
+    OnErrorCallback mOnErrorCallback;
+
+    Pollable::Timestamp mDeadline = Pollable::Timestamp::max();
+    std::vector<unsigned char> mBuffer;
+    int mPipeFd = -1;
+    std::bitset<256> mReportedVersionMismatches;
+};
