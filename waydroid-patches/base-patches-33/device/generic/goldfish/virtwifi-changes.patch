+
+class RemoteConnection {
+public:
+    using OnFrameCallback = std::function<void (std::unique_ptr<Frame>)>;
+    using OnAckCallback = std::function<void (FrameInfo&)>;
+    using OnErrorCallback = OnAckCallback;
